# Client configuration of the Starlink congestion-control campaign (Raspberry Pi 4).
# A variable of the same name in the environment overrides this file (ROUNDS=1 ./run.sh run).
#
# SERVER_HOST, MANIFEST_PORT  server reached by IP literal, so name resolution never enters
#                    the timing; any instance port serves manifest.json.
# CURL_BIN           curl built on ngtcp2 + nghttp3. Debian 13's packaged curl uses OpenSSL's
#                    own QUIC stack instead. The ngtcp2 back end extends every stream window
#                    to 10 MiB, far above the Starlink bandwidth-delay product, so receiver
#                    flow control never caps the sender's congestion window.
# TLS13_CIPHERS      ChaCha20-Poly1305. The Pi 4 Cortex-A72 lacks ARMv8 crypto extensions,
#                    so AES-GCM runs in scalar software, whereas ChaCha20 uses NEON.
# ROUNDS             randomised complete blocks; each block holds every controller x payload.
# GAP_SECONDS        idle time before each transfer so queues drain between controllers.
# CONNECT_TIMEOUT_SECONDS, MAX_TIME_SECONDS  a transfer exceeding either one is a failure.
# DISH_ADDRESS, DISH_INTERVAL_SECONDS  Starlink dish gRPC endpoint and sampling period.
# CPU_INTERVAL_SECONDS  period of the client CPU and temperature series.
# RESULTS_DIR        one sub-directory per campaign, relative to this file.
# SEED               block-order seed; empty draws one at random. Always stored in meta.json.

SERVER_HOST=47.129.174.173
MANIFEST_PORT=4451
CURL_BIN=~/quic-curl/curl-http3/bin/curl
TLS13_CIPHERS=TLS_CHACHA20_POLY1305_SHA256
ROUNDS=30
GAP_SECONDS=5
CONNECT_TIMEOUT_SECONDS=10
MAX_TIME_SECONDS=180
DISH_ADDRESS=192.168.100.1:9200
DISH_INTERVAL_SECONDS=1
CPU_INTERVAL_SECONDS=1
RESULTS_DIR=results
SEED=
