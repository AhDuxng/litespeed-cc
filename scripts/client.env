# Client configuration of the Starlink end-to-end download campaign (Raspberry Pi 4).
# A variable of the same name in the environment overrides this file (ROUNDS=1 ./run.sh run).
#
# SERVER_HOST, MANIFEST_PORT  server reached by IP literal, so name resolution never enters
#                    the timing; the tcp port of any instance serves manifest.json.
# CURL_BIN           curl built on ngtcp2 + nghttp3 (HTTP/3) and nghttp2 (HTTP/2). Debian 13's
#                    packaged curl uses OpenSSL's own QUIC stack instead. The ngtcp2 back end
#                    extends every stream window to 10 MiB, far above the Starlink
#                    bandwidth-delay product, so receiver flow control never caps the sender.
# TLS12_CIPHERS      ChaCha20-Poly1305 for every stack: the Pi 4 Cortex-A72 lacks ARMv8 crypto
# TLS13_CIPHERS      extensions, so AES-GCM runs in scalar software, whereas ChaCha20 uses
#                    NEON. TLS 1.2 uses the ECDSA suite that matches the server's P-256 key.
# TLS_GROUPS         key exchange of every stack. OpenSSL 3.5 offers the hybrid X25519MLKEM768
#                    share by default, which spreads the ClientHello over two QUIC Initial
#                    packets; after its Retry, lsquic 4.4.1 then closes most of those
#                    handshakes with INTERNAL_ERROR. X25519 first gives every stack the same
#                    group (the server prefers it) and a one-packet hello; P-256 must follow
#                    because in TLS 1.2 the list also admits the curve of the server's ECDSA
#                    certificate (RFC 8422, 5.1), without it the client aborts (wrong curve).
# ROUNDS             rounds of windows; each round holds one window per server algorithm and
#                    each window one batch of every stack x payload (10 min per round).
# GAP_SECONDS        idle time before each transfer so queues drain between transfers.
# CONNECT_TIMEOUT_SECONDS, MAX_TIME_SECONDS  a transfer exceeding either one is a failure.
# DISH_ADDRESS, DISH_INTERVAL_SECONDS  Starlink dish gRPC endpoint and sampling period.
# CPU_INTERVAL_SECONDS  period of the client CPU and temperature series.
# RESULTS_DIR        one sub-directory per campaign, relative to this file.
# SEED               batch-order seed; empty draws one at random. Always stored in meta.json.

SERVER_HOST=47.129.174.173
MANIFEST_PORT=443
CURL_BIN=~/quic-curl/curl-http3/bin/curl
TLS12_CIPHERS=ECDHE-ECDSA-CHACHA20-POLY1305
TLS13_CIPHERS=TLS_CHACHA20_POLY1305_SHA256
TLS_GROUPS=X25519:P-256
ROUNDS=30
GAP_SECONDS=5
CONNECT_TIMEOUT_SECONDS=10
MAX_TIME_SECONDS=180
DISH_ADDRESS=192.168.100.1:9200
DISH_INTERVAL_SECONDS=1
CPU_INTERVAL_SECONDS=1
RESULTS_DIR=results
SEED=
