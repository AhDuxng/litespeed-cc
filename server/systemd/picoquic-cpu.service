# 1 Hz CPU accounting of every picoquic instance from its cgroup v2 counters,
# written to logs/cpu.csv for joining with client-side transfer intervals.

[Unit]
Description=CPU monitor for the picoquic congestion-control instances
After=network-online.target

[Service]
Type=exec
User=@SERVICE_USER@
ExecStart=/usr/bin/python3 @CODE_DIR@/bin/cpu_monitor.py --interval 1 --output @LOG_DIR@/cpu.csv @MONITOR_UNITS@
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@LOG_DIR@

[Install]
WantedBy=multi-user.target
